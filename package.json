{
  "name": "eslint-plugin-no-magic",
  "version": "1.8.3",
  "description": "ESLint rule that flags magic string literals only in suspicious contexts (comparisons, switch cases, action types, analytics/storage/feature-flag/route sinks) and on duplication, instead of reporting every literal.",
  "type": "module",
  "license": "MIT",
  "author": "Guido Modarelli",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "no-magic-strings",
    "magic-strings",
    "magic-numbers"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./formatter": {
      "types": "./dist/formatter.d.ts",
      "default": "./dist/formatter.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "MIGRATION.md",
    "docs/rules"
  ],
  "scripts": {
    "test": "pnpm build && vitest run",
    "lint": "eslint .",
    "typecheck": "pnpm build && tsc --project tsconfig.json",
    "benchmark": "pnpm build && node benchmarks/strings.js",
    "release:prepare": "node scripts/prepare-release.js",
    "benchmark:constants": "pnpm build && node benchmarks/constants.js",
    "benchmark:memory": "pnpm build && node benchmarks/memory.js",
    "build": "node scripts/build.js",
    "prepack": "pnpm build",
    "check": "node scripts/check.js"
  },
  "peerDependencies": {
    "eslint": "^10.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@typescript-eslint/parser": "^8.70.0",
    "@typescript-eslint/utils": "^8.70.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "10.10.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^26.0.0",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.3.4",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guidomodarelli/eslint-plugin-no-magic.git"
  },
  "bugs": {
    "url": "https://github.com/guidomodarelli/eslint-plugin-no-magic/issues"
  },
  "homepage": "https://github.com/guidomodarelli/eslint-plugin-no-magic#readme"
}
