{
  "name": "eslint-plugin-no-magic",
  "version": "1.7.4",
  "description": "ESLint rule that flags magic string literals only in suspicious contexts (comparisons, switch cases, action types, analytics/storage/feature-flag/route sinks) and on duplication, instead of reporting every literal.",
  "type": "module",
  "license": "MIT",
  "author": "Guido Modarelli",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "no-magic-strings",
    "magic-strings",
    "magic-numbers"
  ],
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./formatter": {
      "types": "./formatter.d.ts",
      "default": "./formatter.js"
    }
  },
  "files": [
    "index.js",
    "rules",
    "README.md",
    "index.d.ts",
    "LICENSE",
    "CHANGELOG.md",
    "MIGRATION.md",
    "formatter.js",
    "formatter.d.ts"
  ],
  "scripts": {
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "benchmark": "node benchmarks/strings.js",
    "release:prepare": "node scripts/prepare-release.js",
    "benchmark:constants": "node benchmarks/constants.js",
    "benchmark:memory": "node benchmarks/memory.js"
  },
  "peerDependencies": {
    "eslint": "^10.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/parser": "^8.70.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "10.10.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^26.0.0",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.3.4",
  "types": "./index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guidomodarelli/eslint-plugin-no-magic.git"
  },
  "bugs": {
    "url": "https://github.com/guidomodarelli/eslint-plugin-no-magic/issues"
  },
  "homepage": "https://github.com/guidomodarelli/eslint-plugin-no-magic#readme"
}
